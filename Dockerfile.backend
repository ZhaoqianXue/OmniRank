FROM python:3.11-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1

# Install system-level dependencies for R (spectral_ranking.R, plot_phenotype_rankings.R).
# libpng/freetype/fontconfig needed for ggplot2 ggsave() PNG output.
RUN apt-get update && apt-get install -y --no-install-recommends \
    r-base r-base-dev build-essential gfortran \
    libcurl4-openssl-dev libssl-dev libxml2-dev \
    libblas-dev liblapack-dev \
    libpng-dev libfreetype6-dev libfontconfig1-dev \
    && rm -rf /var/lib/apt/lists/*

# Install R packages for spectral_ranking.R and plot_phenotype_rankings.R.
# spectral_ranking.R: readr, dplyr, jsonlite
# plot_phenotype_rankings.R: ggstatsplot, gghalves, tidyverse, paletteer, ggplot2,
#   ggrepel, patchwork, forcats, jsonlite (grid is base R)
RUN R -e "install.packages(c('readr','dplyr','jsonlite','ggplot2','tidyverse','ggrepel','patchwork','forcats','paletteer','gghalves','ggstatsplot'), repos='https://cloud.r-project.org')"

WORKDIR /opt/render/project/src

# Install backend Python dependencies first for better layer caching.
COPY src/api/requirements.txt ./src/api/requirements.txt
RUN pip install --no-cache-dir -r src/api/requirements.txt

# Copy runtime source code, scripts, and built-in example datasets.
COPY src ./src
COPY shared ./shared
COPY data ./data
COPY scripts ./scripts

# Keep a non-mounted copy of examples so volume mounts under /data
# cannot shadow built-in datasets.
RUN mkdir -p /opt/render/project/bundled_examples \
    && cp -r /opt/render/project/src/data/examples/. /opt/render/project/bundled_examples/

ENV OMNIRANK_EXAMPLE_DATA_DIR=/opt/render/project/bundled_examples

EXPOSE 10000

CMD ["sh", "-c", "uvicorn main:app --app-dir src/api --host 0.0.0.0 --port ${PORT:-10000}"]
